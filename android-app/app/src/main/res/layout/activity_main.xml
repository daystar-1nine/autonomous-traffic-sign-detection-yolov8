<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Preview Stream -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Transparent Sci-Fi Cockpit HUD Canvas -->
    <com.autonomous.aicontrol.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Telemetry & Status Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#DD0A0F14"
        android:padding="6dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Vehicle Mode Indicator Badge -->
        <TextView
            android:id="@+id/tvModeIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[EMERGENCY STOP]"
            android:textColor="@color/hud_red"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- Gamepad Connection Badge -->
        <TextView
            android:id="@+id/tvGamepadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[GAMEPAD: DISCONNECTED]"
            android:textColor="@color/hud_orange"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="FPS: 0.0"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvInference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="AI: 0.0ms"
            android:textColor="@color/hud_yellow"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvCarStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="CAR UDP: --"
            android:textColor="@color/hud_cyan"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Side Diagnostic Telemetry Box (Cosmic Byte Ares Pro & Motor Speeds) -->
    <LinearLayout
        android:id="@+id/sideDiagnosticPanel"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#B3050B10"
        android:padding="8dp"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DIAGNOSTIC TELEMETRY"
            android:textColor="@color/hud_cyan"
            android:textStyle="bold"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvDiagDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device: None"
            android:textColor="@color/hud_gray"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvDiagLeftStick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="L-Stick: X: 0.00 | Y: 0.00"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvDiagRightStick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R-Stick: X: 0.00 | Y: 0.00"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvDiagTriggers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Triggers: LT: 0.0 | RT: 0.0"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvDiagButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buttons: None"
            android:textColor="@color/hud_yellow"
            android:textSize="10sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvMotorOutputs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOTORS: L: 0 | R: 0 PWM"
            android:textColor="@color/hud_green"
            android:textStyle="bold"
            android:textSize="10sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvGamepadLegend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAMEPAD KEYS:\n[START / B] Auto Run / Pause\n[A] Manual Mode   [X] E-STOP\n[L1] Speed Profile [Y] Cruise"
            android:textColor="@color/hud_cyan"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Bottom Controls & Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E60A0F14"
        android:padding="8dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Vehicle Action & Sign Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/tvCurrentAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTION: EMERGENCY STOP (LOCKED)"
                android:textColor="@color/hud_red"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSignInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET: NONE | ZONE: CLEAR"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvSpeedProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFILE: NORMAL (75%) [Press Y / Tap to Cycle]"
                android:textColor="@color/hud_yellow"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Mode Buttons: MANUAL, AUTONOMOUS, EMERGENCY STOP -->
        <Button
            android:id="@+id/btnManualMode"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:text="MANUAL (A)"
            android:backgroundTint="@color/hud_orange"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAutoMode"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:text="AUTO (B)"
            android:backgroundTint="@color/hud_cyan"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAutoToggleRun"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:text="▶ START [B/START]"
            android:backgroundTint="@color/hud_green"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEmergencyStop"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="E-STOP (X)"
            android:backgroundTint="@color/hud_red"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
